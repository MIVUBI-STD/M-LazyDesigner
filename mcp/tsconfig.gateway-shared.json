{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": ".cache/gateway-shared",
    "tsBuildInfoFile": ".cache/gateway-shared.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": [
      "bun"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "lib/runtime/fetch.ts",
    "lib/runtime/connection.ts",
    "lib/capabilityMetadata.ts",
    "lib/capabilities/manifest.ts",
    "lib/authoringPhase.ts",
    "lib/registrationProfile.ts",
    "lib/runtime/affinity.ts"
  ],
  "exclude": []
}
