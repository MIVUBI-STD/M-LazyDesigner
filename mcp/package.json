{
  "name": "blockit-bedrock-entity-mcp",
  "version": "0.2.0",
  "description": "Minecraft Bedrock Entity-focused MCP server plugin for Blockbench",
  "keywords": [
    "Blockbench",
    "MCP"
  ],
  "license": "GPL-3.0-only",
  "author": "Halo Karya Media",
  "contributors": [
    "Jason J. Gardner"
  ],
  "type": "module",
  "main": "dist/blockit_mcp.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:gateway": "tsc -p gateway/tsconfig.json --noEmit",
    "typecheck:profile": "tsc --noEmit --extendedDiagnostics",
    "test": "bun test",
    "test:runtime": "bun test tests/*.test.ts",
    "gateway": "bun run ./gateway/index.ts",
    "setup:tls": "bun run ./scripts/setup-runtime-tls.ts",
    "measure:surface": "bun run ./scripts/measure-default-surface.ts",
    "measure:phases": "bun run ./scripts/measure-phase-surfaces.ts",
    "measure:control": "bun run ./scripts/measure-control-context.ts",
    "measure:astra-context": "bun run ./scripts/measure-astra-context.ts",
    "eval:quality-benchmark": "bun test tests/quality-benchmark-contract.test.ts",
    "eval:call-efficiency": "bun test tests/tool-call-efficiency-contract.test.ts",
    "verify:repository": "bun test tests/repository/*.test.ts",
    "verify:authoring": "bun test tests/authoring/*.test.ts",
    "verify:fixture-static": "bun test tests/authoring/current-workspace-fixture-static.test.ts",
    "verify:closure": "bun run verify:repository && bun run verify:authoring && bun run docs:check",
    "verify:mcp": "bun run docs:check && bun run typecheck && bun run typecheck:gateway && bun run test:runtime && bun run verify:authoring && bun run measure:surface && bun run measure:phases && bun run build",
    "verify:full": "bun run verify:repository && bun run verify:mcp",
    "verify:release": "bun run verify:full",
    "eval:tool-discovery": "bun run ./scripts/evaluate-tool-discovery.ts",
    "verify:stateless-local": "bun run ./scripts/verify-stateless-local.ts",
    "verify:geometry-live": "bun run ./scripts/verify-geometry-live.ts",
    "verify:surface-gap-live": "bun run ./scripts/verify-surface-gap-live.ts",
    "verify:texturing-live": "bun run ./scripts/verify-texturing-live.ts",
    "verify:animation-live": "bun run ./scripts/verify-animation-live.ts",
    "verify:particle-live": "bun run ./scripts/verify-particle-live.ts",
    "verify:persistence-live": "bun run ./scripts/verify-persistence-live.ts",
    "verify:project-affinity-live": "bun run ./scripts/verify-project-affinity-live.ts",
    "deploy:local": "bun run build && bun run ./scripts/deploy-local.ts",
    "deploy:verified": "bun run ./scripts/verified-build-artifact.ts deploy",
    "prompts:build": "bun run ./build/generate-manifest.ts",
    "dev": "bun run prompts:build && bun run ./build --sourcemap",
    "dev:watch": "bun run prompts:build && bun run ./build --sourcemap --watch",
    "dev:sync": "bun run prompts:build && bun run ./build --sourcemap --watch --sync",
    "build": "bun run prompts:build && bun run ./build --minify",
    "docs:build": "bun run ./build/docs.ts",
    "docs:check": "bun run ./build/check-docs-freshness.ts",
    "docs:serve": "bun run docs/index.html",
    "docs": "bun run prompts:build && bun run docs:build && bun run docs:serve",
    "inspect": "bunx @modelcontextprotocol/inspector",
    "eval:routed-tool-loading": "bun run ./scripts/evaluate-routed-tool-loading.ts",
    "verify:template-live": "bun run ./scripts/verify-template-live.ts",
    "verify:uv-density-live": "bun run ./scripts/verify-uv-density-live.ts",
    "audit:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:unused:gateway": "tsc -p gateway/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "verify:texture-runtime-live": "bun run ./scripts/verify-texture-runtime-live.ts",
    "conformance:serve": "bun run ./scripts/serve-conformance-runtime.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "blockbench-types": "5.1.0",
    "tinycolor2": "^1.6.0",
    "typescript": "^5.9.3"
  }
}
