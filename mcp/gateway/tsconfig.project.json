{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../.cache/gateway-project",
    "tsBuildInfoFile": "../.cache/gateway-project.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "references": [
    {
      "path": "../tsconfig.semantic-core.json"
    },
    {
      "path": "../tsconfig.gateway-shared.json"
    }
  ],
  "include": [
    "./**/*.ts",
    "../package.json"
  ],
  "exclude": [
    "./dist"
  ]
}
